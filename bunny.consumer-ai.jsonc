{
  "$schema": "./node_modules/@bunny.net/config/generated/schema.json",
  "version": "2026-05-11",
  "app": {
    "name": "twoday-consumer-ai",
    "scaling": { "min": 1, "max": 1 },
    "regions": ["FR"],
    "containers": {
      "consumer-ai": {
        "dockerfile": "Dockerfile.consumer-ai",
        "port": 3000,
        "env": {
          "LOCAL_AI_BASE_URL": "LOCAL_AI_BASE_URL",
          "LOCAL_AI_API_KEY": "LOCAL_AI_API_KEY",
          "LOCAL_AI_MODEL": "LOCAL_AI_MODEL",
          "PORT": "PORT"
        }
      }
    }
  }
}
